<Page x:Class="BVELauncher.App.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:BVELauncher.App.ViewModels" xmlns:local="using:BVELauncher.App">
  <Page.Resources>
    <CollectionViewSource x:Name="GroupedScenarios" IsSourceGrouped="True" ItemsPath="Items" Source="{x:Bind ViewModel.Groups,Mode=OneWay}" />
    <DataTemplate x:Key="CardTemplate" x:DataType="vm:ScenarioCardViewModel">
      <Grid Width="244" Padding="8" RowSpacing="8" AutomationProperties.Name="{x:Bind Title,Mode=OneWay}">
        <Grid.RowDefinitions><RowDefinition Height="136"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
          <Grid><FontIcon Glyph="&#xE7C0;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Image Source="{x:Bind local:MainPage.CachedImage(ThumbnailPath),Mode=OneWay}" Stretch="UniformToFill" /></Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="{x:Bind Title,Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        <Grid Grid.Row="2"><TextBlock Text="{x:Bind VehicleTitle,Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,40,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4"><TextBlock Text="{x:Bind Favorite,Mode=OneWay}"/><TextBlock Text="{x:Bind Warning,Mode=OneWay}" /></StackPanel></Grid>
        <TextBlock Text="{x:Bind Status,Mode=OneWay}" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
        <Button Content="⋯" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ScenarioActions_Click" Loaded="ScenarioActions_Loaded"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ListTemplate" x:DataType="vm:ScenarioCardViewModel">
      <Grid Padding="8" ColumnSpacing="16" AutomationProperties.Name="{x:Bind Title,Mode=OneWay}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Height="48" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}"><Grid><FontIcon Glyph="&#xE7C0;"/><Image Source="{x:Bind local:MainPage.CachedImage(ThumbnailPath),Mode=OneWay}" Stretch="UniformToFill"/></Grid></Border>
        <TextBlock Grid.Column="1" Text="{x:Bind Title,Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{x:Bind VehicleTitle,Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="3" Text="{x:Bind RouteTitle,Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{x:Bind Warning,Mode=OneWay}"/><TextBlock Text="{x:Bind Status,Mode=OneWay}"/><Button Content="⋯" Click="ScenarioActions_Click" Loaded="ScenarioActions_Loaded"/></StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="GroupTemplate" x:DataType="vm:ScenarioGroup"><Button Content="{x:Bind Title,Mode=OneWay}" Tag="{x:Bind Title}" Click="Group_Click" AutomationProperties.AutomationId="GroupToggle" Margin="8,12,0,8"/></DataTemplate>
  </Page.Resources>
  <Grid x:Name="DropTarget" AllowDrop="True" Background="Transparent" DragOver="DragOver_Import" DragLeave="DragLeave_Import" Drop="Drop_Import" AutomationProperties.AutomationId="DropTarget" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <CommandBar DefaultLabelPosition="Right" IsOpen="False" Background="Transparent">
      <CommandBar.Content><AutoSuggestBox x:Name="SearchBox" Width="280" Text="{x:Bind ViewModel.SearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" QueryIcon="Find" AutomationProperties.AutomationId="SearchBox"/></CommandBar.Content>
      <AppBarButton x:Name="ImportButton" Icon="Add" Click="Import_Click" AutomationProperties.AutomationId="ImportButton"/>
      <AppBarButton x:Name="FolderButton" Icon="Folder" Click="Folder_Click" AutomationProperties.AutomationId="FolderButton"/>
      <AppBarButton x:Name="RefreshButton" Icon="Refresh" Command="{x:Bind ViewModel.RescanCommand}" AutomationProperties.AutomationId="RefreshButton"/>
      <AppBarSeparator />
      <AppBarButton x:Name="VehiclesButton" Icon="Library" Click="Vehicles_Click" AutomationProperties.AutomationId="VehiclesButton"/>
      <AppBarButton x:Name="GridButton" Icon="AllApps" Click="Grid_Click" AutomationProperties.AutomationId="GridButton"/>
      <AppBarButton x:Name="ListButton" Icon="List" Click="List_Click" AutomationProperties.AutomationId="ListButton"/>
      <AppBarButton x:Name="SettingsButton" Icon="Setting" Click="Settings_Click" AutomationProperties.AutomationId="SettingsButton"/>
    </CommandBar>
    <Grid Grid.Row="1" Margin="16,0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="FilterBox" Width="180" SelectionChanged="Filter_Changed" AutomationProperties.AutomationId="FilterBox"/><ComboBox x:Name="SortBox" Grid.Column="1" Width="180" SelectionChanged="Sort_Changed" AutomationProperties.AutomationId="SortBox"/><Button x:Name="DriveButton" Grid.Column="2" Command="{x:Bind ViewModel.DriveCommand}" AutomationProperties.AutomationId="DriveButton"/></Grid>
    <Grid Grid.Row="2" Margin="8,0">
      <GridView x:Name="ScenarioGrid" ItemsSource="{x:Bind GroupedScenarios.View,Mode=OneWay}" ItemTemplate="{StaticResource CardTemplate}" IsItemClickEnabled="True" ItemClick="Scenario_Click" SelectionMode="Single" SelectionChanged="Selection_Changed" RightTapped="Scenario_RightTapped" KeyDown="Scenarios_KeyDown" DoubleTapped="Scenarios_DoubleTapped" AutomationProperties.AutomationId="ScenarioGrid" Visibility="{x:Bind local:MainPage.Visible(ViewModel.GridView),Mode=OneWay}">
        <GridView.GroupStyle><GroupStyle HeaderTemplate="{StaticResource GroupTemplate}" HidesIfEmpty="False" /></GridView.GroupStyle>
      </GridView>
      <ListView x:Name="ScenarioList" ItemsSource="{x:Bind GroupedScenarios.View,Mode=OneWay}" ItemTemplate="{StaticResource ListTemplate}" IsItemClickEnabled="True" ItemClick="Scenario_Click" SelectionMode="Single" SelectionChanged="Selection_Changed" RightTapped="Scenario_RightTapped" KeyDown="Scenarios_KeyDown" DoubleTapped="Scenarios_DoubleTapped" AutomationProperties.AutomationId="ScenarioList" Visibility="{x:Bind local:MainPage.Hidden(ViewModel.GridView),Mode=OneWay}">
        <ListView.GroupStyle><GroupStyle HeaderTemplate="{StaticResource GroupTemplate}" HidesIfEmpty="False" /></ListView.GroupStyle>
      </ListView>
      <StackPanel x:Name="EmptyState" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsEmpty),Mode=OneWay}"><FontIcon Glyph="&#xE7C0;"/><TextBlock x:Name="EmptyText" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="EmptyText"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"><Button x:Name="EmptyFolderButton" Click="Folder_Click" AutomationProperties.AutomationId="EmptyFolderButton"/><Button x:Name="EmptyImportButton" Click="Import_Click" AutomationProperties.AutomationId="EmptyImportButton"/></StackPanel></StackPanel>
    </Grid>
    <Grid Grid.Row="3" Margin="16,4,16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind ViewModel.Status,Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="StatusText"/><Button x:Name="CancelButton" Grid.Column="1" Command="{x:Bind ViewModel.CancelCommand}" Visibility="{x:Bind local:MainPage.Visible(ViewModel.IsBusy),Mode=OneWay}" AutomationProperties.AutomationId="CancelButton"/></Grid>
    <Border x:Name="DropOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" IsHitTestVisible="False"><TextBlock x:Name="DropText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}"/></Border>
  </Grid>
</Page>
